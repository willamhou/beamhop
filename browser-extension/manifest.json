{
  "manifest_version": 3,
  "name": "Beamhop",
  "version": "0.1.0",
  "description": "Capture the current tab and send it to the Beamhop desktop app.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture with Beamhop"
  }
}
